{
  "functions": {
    "api/sentiment.js": {
      "maxDuration": 30
    },
    "api/batch.js": {
      "maxDuration": 60
    },
    "api/summary.js": {
      "maxDuration": 20
    }
  },
  "routes": [
    {
      "src": "/api/sentiment",
      "dest": "/api/sentiment.js"
    },
    {
      "src": "/api/batch",
      "dest": "/api/batch.js"
    },
    {
      "src": "/api/summary",
      "dest": "/api/summary.js"
    }
  ]
}